# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# .env.local NÃO é versionado.

# Estas duas chegam ao bundle do frontend — use SOMENTE valores públicos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NÃO coloque aqui, nem em nenhum arquivo VITE_*:
#   SUPABASE_SERVICE_ROLE_KEY
#   chaves de API de modelo de IA
# Esses segredos vivem apenas nos secrets das edge functions:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# Qualquer variável com prefixo VITE_ é embutida no JavaScript público.
